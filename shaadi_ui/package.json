{
	"name": "shaadi-ui",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build --base=/assets/shaadi/ && yarn copy-html-entry && node scripts/post-build.js",
		"copy-html-entry": "cp ../shaadi/public/index.html ../shaadi/www/shaadi.html",
		"preview": "vite preview",
		"lint": "biome check --write .",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"feather-icons": "^4.29.2",
		"frappe-ui": "0.1.105",
		"socket.io-client": "^4.7.2",
		"vue": "^3.5.13",
		"vue-router": "^4.5.0"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@iconify/json": "^2.2.451",
		"@vitejs/plugin-vue": "4.4.0",
		"@vitest/coverage-v8": "^2.1.8",
		"autoprefixer": "^10.4.2",
		"jsdom": "^25.0.1",
		"postcss": "^8.4.5",
		"tailwindcss": "^3.4.15",
		"unplugin-icons": "^23.0.1",
		"vite": "6.4.3",
		"vitest": "^2.1.8"
	}
}
